# ---------------------------------------------------------------------------
# VELTRIX — environment variables
# Copy to .env.local and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# Public URL of this app (used for auth redirects and public booking links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API). The anon/publishable key is safe for the browser;
# every table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI assistant (optional). Without a key the assistant page explains how to enable it.
# Server-only — never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-opus-5-5
AI_MODEL=
# Max assistant messages per organization per day (basic usage limit).
AI_DAILY_MESSAGE_LIMIT=200

# Future integrations (not implemented yet — leave empty). See docs/INTEGRATIONS.md.
# EMAIL_PROVIDER=
# WHATSAPP_BUSINESS_TOKEN=
